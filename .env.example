SETQUERRY_ENV=development
# MODEL_MODE=architecture executes all three existing neural networks (random weights if missing).
# Production is the default. Set MODEL_MODE=demo to compute untrained/baseline outputs.
MODEL_MODE=production
SETQUERY_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Optional paths. Defaults are data/raw/modelN and ml/checkpoints/modelN_baseline.pt.
# SETQUERY_MODEL1_DATA_ROOT=C:\path\to\Model1_RSVQA-HR
# SETQUERY_MODEL2_DATA_ROOT=C:\path\to\Model2_LEVIR-CD
# SETQUERY_MODEL1_CHECKPOINT=C:\path\to\model1_baseline.pt
# SETQUERY_MODEL2_CHECKPOINT=C:\path\to\model2_baseline.pt
# SETQUERY_MODEL3_CHECKPOINT=C:\path\to\model3_baseline.pt
